CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-tdeck-8MiB.csv"

# --- T-Deck: WiFi/LWIP buffers to PSRAM (recover internal DRAM) ---
# TRY_ALLOCATE moves WiFi/LWIP dynamic allocations to SPIRAM. It also
# silently raises STATIC_RX 10->16 and RX_BA_WIN 6->16, so pin those
# explicitly. The T-Deck is a TCP client carrying LoRa-class traffic;
# small buffer counts are ample. SPIRAM_USE_MALLOC forces TX buffers
# static (16 x ~1.6K internal) -- reduce to 8.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
